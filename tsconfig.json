{
  "compilerOptions": {
    "esModuleInterop": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@revit/app/*": ["./packages/app/*"],
      "@revit/ui/*": ["./packages/ui/*"],
      "@revit/api/*": ["./packages/api/*"],
      "@revit/db/*": ["./packages/db/*"]
    }
  },
  "extends": "./tsconfig.base",
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/types",
    "apps/web/out",
    "apps/web/.next",
    "apps/web/.tamagui"
  ]
}
