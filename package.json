{
  "name": "revit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "cd apps/mobile && yarn start",
    "mobile:prebuild": "cd apps/mobile && yarn prebuild",
    "ios": "cd apps/mobile && yarn ios",
    "android": "cd apps/mobile && yarn android",
    "watch": "ultra -r --no-pretty --concurrency 400 watch",
    "vercel:install": "yarn set version 3.5 && yarn install",
    "web": "yarn build && cd apps/web && yarn dev",
    "web:extract": "DISABLE_EXTRACTION=false yarn workspace revit-web dev",
    "web:prod": "yarn workspace revit-web build",
    "web:prod:serve": "yarn workspace revit-web serve",
    "postinstall": "yarn check-tamagui && yarn build",
    "build": "yarn workspaces foreach --all --exclude revit-web run build",
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "check-tamagui": "tamagui check",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "yarn create tamagui --template takeout-starter --info",
    "prepare": "husky",
    "db:push": "supabase db push",
    "db:clear": "supabase db reset --linked"
  },
  "resolutions": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-refresh": "^0.14.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@tamagui/cli": "^1.132.23",
    "check-dependency-version-consistency": "^5.0.1",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "~5.9.2",
    "ultra-runner": "^3.10.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": "22",
    "npm": "10.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "supabase": "2.40.7"
  }
}
